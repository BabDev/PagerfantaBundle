{
    "name": "babdev/pagerfanta-bundle",
    "type": "symfony-bundle",
    "description": "Bundle integrating Pagerfanta with Symfony",
    "keywords": ["pagerfanta", "pagination", "symfony"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "pagerfanta/core": "^5.0",
        "psr/container": "^1.0 || ^2.0",
        "symfony/config": "^6.4 || ^7.4 || ^8.1",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.1",
        "symfony/http-foundation": "^6.4 || ^7.4 || ^8.1",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.1",
        "symfony/property-access": "^6.4 || ^7.4 || ^8.1",
        "symfony/routing": "^6.4 || ^7.4 || ^8.1"
    },
    "require-dev": {
        "jms/serializer": "^3.32",
        "jms/serializer-bundle": "^5.4",
        "matthiasnoback/symfony-dependency-injection-test": "^6.2",
        "pagerfanta/twig": "^5.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "2.3.1",
        "phpstan/phpstan-phpunit": "2.1.1",
        "phpstan/phpstan-symfony": "2.1.0",
        "phpunit/phpunit": "12.5.38",
        "rector/rector": "2.7.0",
        "symfony/serializer": "^6.4 || ^7.4 || ^8.1",
        "symfony/twig-bridge": "^6.4 || ^7.4 || ^8.1",
        "symfony/twig-bundle": "^6.4 || ^7.4 || ^8.1",
        "symfony/translation": "^6.4 || ^7.4 || ^8.1",
        "twig/twig": "^3.29"
    },
    "conflict": {
        "jms/serializer": "<3.32",
        "jms/serializer-bundle": "<5.4",
        "pagerfanta/twig": "<5.0",
        "symfony/serializer": "<6.4 || >=7.0,<7.4 || ~8.0.0",
        "symfony/translation": "<6.4 || >=7.0,<7.4 || ~8.0.0",
        "symfony/twig-bridge": "<6.4 || >=7.0,<7.4 || ~8.0.0",
        "symfony/twig-bundle": "<6.4 || >=7.0,<7.4 || ~8.0.0",
        "twig/twig": "<3.29",
        "white-october/pagerfanta-bundle": "*"
    },
    "suggest": {
        "jms/serializer-bundle": "To use the Pagerfanta class with the JMS Serializer",
        "symfony/serializer": "To use the Pagerfanta class with the Symfony Serializer",
        "symfony/translation": "To use the Twig templates with translation support",
        "twig/twig": "To integrate Pagerfanta with Twig through extensions"
    },
    "autoload": {
        "psr-4": {
            "BabDev\\PagerfantaBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BabDev\\PagerfantaBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev"
}
